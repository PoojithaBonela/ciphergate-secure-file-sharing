# Environment — copy to .env and fill in real values
# Never commit .env to version control

# Server
PORT=5000

# Client origin (for CORS)
CLIENT_URL=http://localhost:3000

# MongoDB Atlas Connection
# Format: mongodb+srv://<username>:<password>@<cluster-address>/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/encra?retryWrites=true&w=majority

# Lookup HMAC Secret (Cryptographically random 32+ byte string)
ENCRA_LOOKUP_SECRET=your-random-lookup-secret-string-min-32-chars

# AWS S3 Configuration
AWS_REGION=ap-southeast-2
AWS_S3_BUCKET=encra-encrypted-files
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
